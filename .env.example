# Database
# Local Docker:
DATABASE_URL=postgresql+asyncpg://dentiva_app:dentiva_app@localhost:5432/dentiva
DATABASE_URL_SYNC=postgresql+psycopg2://dentiva:dentiva@localhost:5432/dentiva
# Railway (Railway provides DATABASE_URL automatically — override with asyncpg format):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@host:5432/dbname

# Encryption key for PII
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Retired keys (comma-separated) kept for DECRYPT-ONLY during/after a rotation.
# To rotate: generate a new key, move the current ENCRYPTION_KEY value here, set
# the new key as ENCRYPTION_KEY. Remove a key here only once no row still uses it.
ENCRYPTION_KEYS_OLD=

# Clerk (from clerk.com → your application → API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# Retell (for webhook signature verification)
RETELL_WEBHOOK_SECRET=
# Retell REST API — needed for the background call-sync (pulls recent calls
# into the DB so the dashboard stays current even when web/test calls fire no
# webhook). Leave CALL_SYNC_ENABLED=false locally; set true on the server.
RETELL_API_KEY=
RETELL_AGENT_ID=
CALL_SYNC_ENABLED=false
CALL_SYNC_INTERVAL_SECONDS=300
CALL_SYNC_LIMIT=20

# Twilio SMS — booking confirmation texts (sent after a booking is created).
# Leave SMS_ENABLED=false locally; set true on the server once all three values
# are filled. From-number must be E.164 (e.g. +15551234567); trial numbers work.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_ENABLED=false

# PMS adapter (mock = Weekend/demo mode, open_dental_real = production)
PMS_ADAPTER=mock

# Open Dental (when ready for production)
OPEN_DENTAL_API_URL=https://api.opendental.com/api/v1
OPEN_DENTAL_DEV_KEY=

# LLM — Groq primary (OpenAI-compatible), Anthropic fallback
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...

# CORS — comma-separated EXACT origins allowed to call the API (no wildcards).
# In prod set the exact dashboard domain(s), e.g.
# CORS_ALLOWED_ORIGINS=https://dentiva-dashboard.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON_LOGS=true            # machine-parseable logs in prod (request_id + practice_id)

# Sentry error monitoring (optional; empty = disabled). PHI is scrubbed before
# send (send_default_pii stays off). Set this in Railway for prod alerting.
SENTRY_DSN=

# Backend public URL — baked into every phone number we provision as its
# inbound webhook. (This file used to say BACKEND_URL, which is not a Settings
# field at all: pydantic silently ignored it, so the one URL that was
# documented did nothing and the one that mattered was undocumented.)
PUBLIC_BASE_URL=https://your-backend.railway.app

# ── The flags that decide tenant isolation and PHI safety ────────────────────
# Owner-role connection for migrations and cross-tenant admin reads. The app
# role is RLS-enforced and owns no tables; without this, migrations fail with
# "must be owner" — which once left production nine days behind main.
DATABASE_URL_PLATFORM=postgresql+asyncpg://owner:password@host:5432/dentiva

# MUST be false (or unset) before a real clinic. True lets the app connect as a
# superuser/BYPASSRLS role, which turns row-level security — the thing keeping
# one clinic's patients invisible to another — into a no-op on every table.
ALLOW_SUPERUSER_DB=false

# Rejects unverified Clerk user-provisioning webhooks in production.
CLERK_WEBHOOK_SECRET=

# Verify X-Twilio-Signature on inbound SMS. Required in production.
TWILIO_VALIDATE_SIGNATURE=true

# ── PMS bridge (NexHealth account-level; per-practice rows carry location) ───
NEXHEALTH_API_KEY=
NEXHEALTH_SUBDOMAIN=
NEXHEALTH_LOCATION_ID=
# Which single practice the env credentials above belong to. Unset is fine with
# ONE clinic; the moment a second practice picks a PMS, this (or per-practice
# credentials) is what stops clinic B reading clinic A's calendar.
PMS_ENV_PRACTICE_ID=
# Writes into the clinic's own calendar. A new clinic connects read-only; turn
# this on only after comparing the two calendars by eye.
PMS_WRITE_ENABLED=false

# The shared fallback number shown before a practice has its own (NUM-1).
RETELL_FROM_NUMBER=
