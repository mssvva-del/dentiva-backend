# Database
# Local Docker:
DATABASE_URL=postgresql+asyncpg://dentiva_app:dentiva_app@localhost:5432/dentiva
DATABASE_URL_SYNC=postgresql+psycopg2://dentiva:dentiva@localhost:5432/dentiva
# Railway (Railway provides DATABASE_URL automatically — override with asyncpg format):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@host:5432/dbname

# Encryption key for PII
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Clerk (from clerk.com → your application → API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# Retell (for webhook signature verification)
RETELL_WEBHOOK_SECRET=

# PMS adapter (mock = Weekend/demo mode, open_dental_real = production)
PMS_ADAPTER=mock

# Open Dental (when ready for production)
OPEN_DENTAL_API_URL=https://api.opendental.com/api/v1
OPEN_DENTAL_DEV_KEY=

# LLM — Groq primary (OpenAI-compatible), Anthropic fallback
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend public URL (used for Retell webhook registration)
BACKEND_URL=https://your-backend.railway.app
