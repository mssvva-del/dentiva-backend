# Database (local Docker)
# App connects as the non-superuser dentiva_app role (created by migration) so
# Row-Level Security is actually enforced. Alembic runs as the owner `dentiva`.
DATABASE_URL=postgresql+asyncpg://dentiva_app:dentiva_app@localhost:5432/dentiva
DATABASE_URL_SYNC=postgresql+psycopg2://dentiva:dentiva@localhost:5432/dentiva

# Encryption key for PII (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Clerk (from clerk.com → your application → API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json

# Retell (for webhook signature verification, get later when setting up agent)
RETELL_WEBHOOK_SECRET=

# PMS adapter (Weekend mode: mock. Production: open_dental_real)
PMS_ADAPTER=mock

# Open Dental (when ready)
OPEN_DENTAL_API_URL=https://api.opendental.com/api/v1
OPEN_DENTAL_DEV_KEY=

# LLM — Groq primary (OpenAI-compatible API), Anthropic fallback.
# OpenAI intentionally unused in weekend mode (no credits).
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
